# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Neon, Supabase, local…)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Gmail, Brevo, Resend…)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les messages du formulaire de contact
SMTP_TO=
# Adresse d'expédition optionnelle (par défaut : SMTP_USER)
SMTP_FROM=

# Seed de l'administrateur (npm run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password
